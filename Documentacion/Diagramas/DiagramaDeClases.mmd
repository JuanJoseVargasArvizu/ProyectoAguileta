

classDiagram


    Inventario -- ElementoInventario
    Agenda -- Renta

    InventarioService ..|> InventarioServiceImp : Implementa
    InventarioController -- InventarioService
    InventarioServiceImp -- Inventario
    InventarioServiceImp -- InventarioRepository

    AgendaService ..|> AgendaServiceImp : Implementa
    AgendaController -- AgendaService
    AgendaServiceImp -- Agenda
    AgendaServiceImp -- AgendaRepository



    class InventarioService{
      <<Interfaz>>
      + obtenerListaDeElementos(elementos : Elemento) ArrayList Elemento
      + crearNuevoElemento(nuevoElemento : Elemento) void
      + eliminarElemento(elementoEliminado : Elemento) void
      + cambiarEstadoDeElemento(elementoCambiado : Elemento) void
      + ReducirAlmacenDeElemento(elementoReducido : Elemento, cantidad : int) void
      + AumentarAlmacenDeElemento(elementoAumentado : Elemento, cantidad : int) void
    
    }

    class AgendaService{
      <<Interfaz>>
      + ObtenerRentas() ArrayList Renta
      + AgregarRenta(RentaNueva : Renta) void
      + EliminarRenta(RentaEliminada : Renta) void
    }

    class InventarioServiceImp{
      - final InventarioRespository inventarioRepository
    }

     class AgendaServiceImp{
      - final AgendaServiceRepository agendaServiceRepository
    }


    class InventarioController{
    }

    class AgendaController{

    }

    class ElementoInventario{
      - m_nombre : String
      - m_categoria : enum
      - m_cantidad : int
      
      + ReducirAlmacen(reduccion : int) void
      + AumentarAlmacen( aumento : int) void
      + Getters()
      + Setters()
    }

    class Inventario{
      - m_elementos : ArrayList Elemento
      + AgregarElemento(nuevoElemento : Elemento) : void
      + EliminarElemento(elementoEliminado : Elemento) : void
      + ObtenerElemento(index : int) : Elemento
      + Getters()
      + Setters()
    }

    class Renta{
      - m_direccion : Direccion
      - m_elementosRentados : ArrayList Elemento
      - m_contacto : String
      - m_fecha : Date
      + Getters()
      + Setters()
    }

    class Agenda{
      - m_rentas : ArrayList Renta
      + AgregarRecordatorio(rentaNueva : Renta) void
      + EliminarRecordatorio(rentaEliminada : Renta) void
            + Getters()
      + Setters()
    }

    class InventarioRepository{
      <<Interfaz>>
      + ObtenerElementos() ArrayList ElementoInventario
      + GuardarElemento(elementoParaGuardar : ElementoInventario) void
      + EliminarElemento(elementoParaEliminar : ElementoInventario) void
      + EncontrarPorID(AUN NO DECIDADA LA ID) : ElementoInventario
    }

    class AgendaRepository{
      <<Interfaz>>
      + ObtenerRentas() ArrayList Renta
      + GuardarRenta(rentaParaGuardar : Renta) void
      + EliminarRenta(rentaParaEliminar : Renta) void
      + EncontrarPorID(AUN NO DECIDADA LA ID) : Renta
    }